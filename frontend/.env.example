# Copie para .env e ajuste se o backend nao estiver em 127.0.0.1:8000.

# Alvo do proxy do Vite em desenvolvimento. O app sempre chama /api/... relativo,
# entao esta variavel so muda para onde o dev server encaminha.
VITE_API_PROXY_TARGET=http://127.0.0.1:8000

# Prefixo usado pelo client HTTP. Em producao aponte para a URL publica da API
# (ex.: https://api.vestibulif.com.br/api) ou mantenha /api atras de um reverse proxy.
VITE_API_BASE_URL=/api
